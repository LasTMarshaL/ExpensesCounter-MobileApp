<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ExpensesCounterMobileApplication.CheckExpensesMenuPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">

    
    <VerticalStackLayout
        Padding="30"
        Spacing="20">
        
        <Label
            x:Name="TotalExpensesSum"
            Text="..."
            TextColor="Purple"
            HorizontalOptions="Center"/>

        <Button
            Text="Check categories" 
            Clicked="CheckCategoriesButtonClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Check history" 
            Clicked="CheckHistoryButtonClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Back" 
            Clicked="GoBackButtonClicked"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>