<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ExpensesCounterMobileApplication.ApplicationLogic.ViewModels"  
    x:Class="ExpensesCounterMobileApplication.AddExpensesMenuPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">

    
    <VerticalStackLayout
        Padding="20"
        Spacing="15">
        
        <Label
            Text="Chouse expenses category"
            FontSize="24"
            TextColor="Purple"
            HorizontalOptions="Center" />
        
        <CollectionView
            ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                
                <DataTemplate
                    
                    x:DataType="local:ExpensesCategoryViewModel">
                    
                    <Border
                        Stroke="Purple"
                        StrokeThickness="1"
                        Padding="10"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout>
                            <Image
                                Source="{Binding Icon}"
                                HeightRequest="40"/>

                            <Label 
                                Text="{Binding Name}"
                                HorizontalOptions="Center"
                                TextColor="Purple"/>
                        </VerticalStackLayout>
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="CategoryClicked"
                                NumberOfTapsRequired="1"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Text="Go back to the main page" 
            Clicked="GoBackToTheMainPageButtonClicked"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage> 