<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ExpensesCounterMobileApplication.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">


    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25">
           
            <Image
                Source="coins.png"
                HeightRequest="170"
                Aspect="AspectFit"/>

            <Label
                Text="Hello!"
                Style="{StaticResource Headline}"
                TextColor="Purple"/>

            <Button
                Text="Add expenses" 
                Clicked="AddExpensesButtonClicked"
                HorizontalOptions="Fill" />

            <Button
                Text="Check expenses" 
                Clicked="CheckExpensesButtonClicked"
                HorizontalOptions="Fill" />

            <Label
                Text="Time to control your expenses!"
                Style="{StaticResource Headline}"
                TextColor="Purple"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
